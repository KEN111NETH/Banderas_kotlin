        // Verde
        androidx.compose.foundation.layout.Column(
            modifier = Modifier
                .weight(1f)
                .fillMaxHeight()
                .background(Color(0xFF006847))
        ) {
        }

        // Blanco
        androidx.compose.foundation.layout.Column(
            modifier = Modifier
                .weight(1f)
                .fillMaxHeight()
                .background(Color.White)
